{
  "name": "@v01dst/agentwatch",
  "version": "0.1.0",
  "description": "Local-first observability and deterministic benchmarking for autonomous coding agents",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist/src",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "bin": {
    "agentwatch": "./bin/agentwatch.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch src/cli.ts",
    "pretest": "npm run build",
    "test": "node --experimental-test-coverage --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2"
  }
}
